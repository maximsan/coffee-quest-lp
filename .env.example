SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="replace-with-local-supabase-secret-key"
COUNT_API_TOKEN="replace-with-local-count-endpoint-token"
BLOB_READ_WRITE_TOKEN="replace-with-local-vercel-blob-token"

# Waitlist confirmation email (Resend). If RESEND_API_KEY is unset, signup still works but no email is sent.
RESEND_API_KEY="replace-with-local-resend-api-key"
WAITLIST_FROM_EMAIL="Coffee Quest <onboarding@resend.dev>"
PUBLIC_SITE_URL="https://your-production-domain.example"

# Optional: included in the confirmation email footer when set.
PRIVACY_POLICY_URL="https://your-production-domain.example/privacy"

# Optional: override footer logo image URL. Defaults to PUBLIC_SITE_URL + /email-logo.png.
# Set to "none" to hide the image.
EMAIL_LOGO_URL="https://your-production-domain.example/email-logo.png"
